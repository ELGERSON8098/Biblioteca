@model Biblioteca.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="container">
    <h2 class="mt-3 mb-3">Eliminar Libro</h2>

    <div class="alert alert-warning">¿Está seguro que desea eliminar este libro?</div>

    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Titulo</dd>

        <dt class="col-sm-3">Autor</dt>
        <dd class="col-sm-9">@Model.Autor</dd>

        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
</div>
