@model IEnumerable<Biblioteca.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
        <h2>Libros</h2>
        <a asp-action="Create" class="btn btn-primary">Agregar libro</a>
    </div>

    <div class="row">
        @foreach (var libro in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(libro.ImagenUrl))
                    {
                        <img src="@libro.ImagenUrl" class="card-img-top" alt="@libro.Titulo" style="height:200px; object-fit:cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@libro.Titulo</h5>
                        <p class="card-text text-muted">@libro.Autor</p>
                        <p class="card-text">@libro.Descripcion</p>
                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-secondary ms-2">Editar</a>
                            <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-sm btn-outline-danger ms-2">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
