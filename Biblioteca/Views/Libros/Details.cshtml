@model Biblioteca.Models.Libro

@{
    ViewData["Title"] = "Detalle del libro";
}

<div class="container">
    <h2 class="mt-3 mb-3">@Model.Titulo</h2>

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl" class="img-fluid" alt="@Model.Titulo" />
            }
        </div>
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">Autor</dt>
                <dd class="col-sm-9">@Model.Autor</dd>

                <dt class="col-sm-3">Categoría</dt>
                <dd class="col-sm-9">@Model.Categoria</dd>

                <dt class="col-sm-3">Año</dt>
                <dd class="col-sm-9">@Model.AnioPublicacion</dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">@Model.Descripcion</dd>
            </dl>

            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </div>
</div>
