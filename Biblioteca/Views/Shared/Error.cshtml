@model ErrorViewModel
@{
    ViewData["Title"] = "Ocurrió un error";
}

<div class="container">
    <div class="d-flex flex-column align-items-center text-center py-5">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 5rem;"></i>
        </div>
        <h1 class="fw-bold mb-2">¡Vaya! Algo salió mal</h1>
        <p class="text-muted fs-5 mb-4" style="max-width: 560px;">
            Se produjo un problema inesperado al procesar su solicitud. El evento ha quedado registrado
            para su revisión. Por favor, intente nuevamente más tarde.
        </p>

        @if (Model != null && Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">
                <strong>Identificador de referencia:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door-fill"></i> Volver al inicio
            </a>
            <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-book-fill"></i> Ir a Libros
            </a>
        </div>
    </div>
</div>
