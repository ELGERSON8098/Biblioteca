@{
    ViewData["Title"] = "Acerca de";
}

<main class="container about-page mt-4">
    <header class="about-header mb-3">
        <h1>Acerca de la Biblioteca Virtual</h1>
        <p class="lead">Una breve descripción de la misión, la colección y los servicios.</p>
    </header>

    <section class="about-mission mb-4">
        <h2>Misión</h2>
        <p>Nuestra misión es ofrecer acceso libre y organizado a recursos informativos y culturales, fomentando la lectura y la investigación.</p>
    </section>

    <section class="about-collection mb-4">
        <h2>Colección</h2>
        <article>
            <h3>Libros y recursos</h3>
            <p>Contamos con una colección diversa que incluye libros impresos, ebooks, artículos y material multimedia.</p>
        </article>
        <article>
            <h3>Autores</h3>
            <p>Trabajamos con autores locales y reconocidos internacionalmente para mantener una colección representativa.</p>
        </article>
    </section>

    <section class="about-services mb-4">
        <h2>Servicios</h2>
        <ul>
            <li>Préstamo y renovación de materiales</li>
            <li>Asesoría en búsquedas bibliográficas</li>
            <li>Acceso a recursos digitales y bases de datos</li>
        </ul>
    </section>

    <section class="about-contact mb-4">
        <h2>Contacto</h2>
        <address>
            Biblioteca Virtual<br />
            Calle Falsa 123<br />
            Email: <a href="mailto:info@biblioteca.local">info@biblioteca.local</a>
        </address>
    </section>
</main>
