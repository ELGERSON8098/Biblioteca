@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container">
    <div class="d-flex flex-column align-items-center text-center py-5">
        <div class="mb-4">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
        </div>
        <h1 class="fw-bold mb-2">Acceso denegado</h1>
        <p class="text-muted fs-5 mb-4" style="max-width: 560px;">
            No cuenta con los permisos necesarios para acceder a esta funcionalidad. Si considera que
            se trata de un error, comuníquese con un administrador del sistema.
        </p>

        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door-fill"></i> Volver al inicio
            </a>
            <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-book-fill"></i> Consultar Libros
            </a>
        </div>
    </div>
</div>
